# Supabase -- Required for all features
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key -- Required for user invitations (server-side only)
# Get it from: Supabase Dashboard > Settings > API > service_role key
# NEVER expose this in client-side code or NEXT_PUBLIC_ prefixed variables
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URL -- Required for invite email redirect links
# Set to your production domain, e.g. https://fleethub.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
